<!DOCTYPE html>
<html lang="zh-hans">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>用户注册 - Test Wiki</title>

    <link rel="stylesheet" type="text/css" href="/-/static/fontawesome/css/all.css?v=fdfed703">
    <link rel="stylesheet" type="text/css" href="/-/static/wikidot-base.css?v=f5447e54">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <script src="/-/static/app.js?v=ff4b1dfc" type="text/javascript"></script>
    <link rel="stylesheet" type="text/css" href="/-/static/system.css?v=23a5007b">
    <link rel="stylesheet" type="text/css" href="/-/static/wikit-tokens.css?v=c274bbb3">
    <link rel="stylesheet" type="text/css" href="/-/static/wikit-shell.css?v=8e298186">
    
    
</head>
<body class="system wikit-page">
    <div class="system-container">
        
        <div class="system-content">
            
            <div class="heading">
                <h1 id="title"></h1>
            </div>
            <div class="content">
                
<div class="wikit-scope">
  <div class="auth-shell">
    
    <form method="POST" id="signup-form" class="auth-column">
      <input type="hidden" name="csrfmiddlewaretoken" value="LQ7bB1SdKE3pHo7cBodgbZSWwoVS2nv6">

      <div class="auth-mark">
        <img src="/-/static/images/wikitHana.png?v=577881c2" alt="ProjectWikit">
      </div>

      <div class="auth-heading">
        <h1 class="h1">创建账号</h1>
      </div>

      

      <div class="form-block">
        <div class="form-row">
          <label class="label" for="id_username">用户名</label>
          <input type="text" name="username" id="id_username" required autofocus placeholder="认领 Wikidot 账号请填写原名" value="">
        </div>

        <div id="wikidot-section" style="display:none;">
          <div class="form-row disabled">
            <span class="meta"><i class="fas fa-info-circle"></i>&nbsp;检测到此用户名对应一个待认领的 Wikidot 账号，需要验证码</span>
          </div>
          <div class="form-row" style="display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: end;">
            <div style="display: flex; flex-direction: column; gap: 6px; min-width: 0;">
              <label class="label" for="id_verification_code">Wikit 验证码</label>
              <input type="text" name="verification_code" id="id_verification_code" placeholder="请输入验证码" inputmode="numeric">
            </div>
            <button type="button" id="send-code-btn" class="btn-ghost" style="align-self: center; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; padding: 8px 12px;">发送验证码</button>
          </div>
          <div id="send-code-msg" class="form-row" style="display: none;"></div>
        </div>

        <div class="form-row">
          <label class="label" for="id_email">邮箱<span class="hint">用于找回密码</span></label>
          <input type="email" name="email" id="id_email" value="" maxlength="254" required placeholder="you@example.com">
        </div>

        <div class="form-row">
          <label class="label" for="id_password">设置密码</label>
          <input type="password" name="password" id="id_password" required placeholder="至少 8 位">
        </div>
        <div class="form-row">
          <label class="label" for="id_password_confirm">再次输入密码</label>
          <input type="password" name="password_confirm" id="id_password_confirm" required placeholder="确认一致">
        </div>
      </div>

      <button type="submit" class="btn-primary" id="submit-btn">立 即 注 册</button>

      <div class="action-row">
        <span class="meta">普通注册默认分配「读者」权限</span>
        <a class="link-muted" href="/-/login">已有账号 → 登录</a>
      </div>

    </form>
    
  </div>
</div>


<script>
(function () {
    const usernameInput = document.getElementById('id_username');
    const wikidotSection = document.getElementById('wikidot-section');
    const sendCodeBtn = document.getElementById('send-code-btn');
    const sendCodeMsg = document.getElementById('send-code-msg');
    const submitBtn = document.getElementById('submit-btn');

    const TEXT = {
        submit: '立 即 注 册',
        claim: '认 领 账 号',
        send: '发送验证码',
        sending: '发送中…',
        sent: '验证码已发送，请前往 Wikidot 站内信查收。',
        failed: '发送失败，请稍后重试',
        network: '网络错误，请稍后重试',
        resend: '重新发送 ({seconds}s)'
    };

    let checkTimer = null;
    let isWikidot = false;

    function updateSubmitBtn() {
        submitBtn.textContent = isWikidot ? TEXT.claim : TEXT.submit;
    }
    updateSubmitBtn();

    usernameInput.addEventListener('input', function () {
        clearTimeout(checkTimer);
        const serverError = document.getElementById('server-error');
        if (serverError) serverError.remove();
        const username = usernameInput.value.trim();
        if (!username) {
            setWikidot(false);
            return;
        }
        checkTimer = setTimeout(function () {
            checkWikidotUsername(username);
        }, 600);
    });

    function checkWikidotUsername(username) {
        fetch('/-/signup/check-wikidot?username=' + encodeURIComponent(username))
            .then(function (r) { return r.json(); })
            .then(function (data) {
                setWikidot(data.is_wikidot);
            })
            .catch(function () {
                setWikidot(false);
            });
    }

    function setWikidot(val) {
        isWikidot = val;
        wikidotSection.style.display = val ? 'block' : 'none';
        updateSubmitBtn();
        if (!val) {
            sendCodeMsg.textContent = '';
            sendCodeMsg.style.display = 'none';
        }
    }

    sendCodeBtn.addEventListener('click', function () {
        const username = usernameInput.value.trim();
        if (!username) return;

        sendCodeBtn.disabled = true;
        sendCodeMsg.style.color = 'var(--muted)';
        sendCodeMsg.style.background = 'var(--well)';
        sendCodeMsg.style.display = 'block';
        sendCodeMsg.textContent = TEXT.sending;

        const formData = new FormData();
        formData.append('username', username);
        formData.append('csrfmiddlewaretoken', document.querySelector('[name=csrfmiddlewaretoken]').value);

        fetch('/-/signup/send-wikidot-code', {
            method: 'POST',
            body: formData
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.ok) {
                    sendCodeMsg.style.color = 'var(--ink)';
                    sendCodeMsg.style.background = 'var(--well)';
                    sendCodeMsg.style.display = 'block';
                    sendCodeMsg.textContent = TEXT.sent;
                    let countdown = 60;
                    sendCodeBtn.textContent = TEXT.resend.replace('{seconds}', countdown);
                    const timer = setInterval(function () {
                        countdown--;
                        if (countdown <= 0) {
                            clearInterval(timer);
                            sendCodeBtn.disabled = false;
                            sendCodeBtn.textContent = TEXT.send;
                        } else {
                            sendCodeBtn.textContent = TEXT.resend.replace('{seconds}', countdown);
                        }
                    }, 1000);
                } else {
                    sendCodeMsg.style.color = 'var(--danger)';
                    sendCodeMsg.style.background = 'transparent';
                    sendCodeMsg.style.display = 'block';
                    sendCodeMsg.textContent = data.error || TEXT.failed;
                    sendCodeBtn.disabled = false;
                }
            })
            .catch(function () {
                sendCodeMsg.style.color = 'var(--danger)';
                sendCodeMsg.style.background = 'transparent';
                sendCodeMsg.style.display = 'block';
                sendCodeMsg.textContent = TEXT.network;
                sendCodeBtn.disabled = false;
            });
    });
})();
</script>


            </div>
        </div>
    </div>
    <div id="w-modals"></div>
</body>
</html>
