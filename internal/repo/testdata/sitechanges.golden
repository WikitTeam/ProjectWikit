<div class="site-changes-box w-site-changes" data-site-changes-path-params="{&quot;p&quot;: &quot;99&quot;, &quot;perpage&quot;: &quot;5&quot;}" data-site-changes-params="{}">
            <style>
                .changes-list{}
                
                .changes-list .pager{
                    margin: 1em 0;
                    text-align: center;
                }
                
                .changes-list-item{
                    /* overflow: hidden; */
                    padding: 2px;
                }
                
                .changes-list-item:hover{
                    background-color: #F2F2F2;
                }
                
                .changes-list-item table{
                    width: 98%;
                    
                }
                
                .changes-list-item .title{
                
                }
                
                .changes-list-item .mod-date{
                    text-align: right;
                    width: 13em;
                
                }
                .changes-list-item .revision-no{
                    text-align: center;
                    width: 7em;
                }
                .changes-list-item .flags{
                    text-align: left;
                    width: 3em;
                }
                .changes-list-item .mod-by{
                    width: 15em;
                    text-align: left;
                }
                
                .changes-list-item .comments{
                    font-size: 95%;
                    color: #666;
                    margin: 2px 0;
                }
            </style>
            <form onsubmit="return false;" action="" method="get">
                <table class="form">
                <tbody>
                <tr>
                    <td>[module-sitechanges-types]</td>
                    <td class="w-type-filter">
                        <label>
                            <input type="checkbox" class="checkbox" checked name="*">
                            [module-sitechanges-types-all]
                        </label>
                        <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="source">
                                [module-sitechanges-type-source]
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="title">
                                [module-sitechanges-type-title]
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="name">
                                [module-sitechanges-type-name]
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="tags">
                                [module-sitechanges-type-tags]
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="new">
                                [module-sitechanges-type-new]
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="parent">
                                [module-sitechanges-type-parent]
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="file_added">
                                [module-sitechanges-type-file-added]
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="file_deleted">
                                [module-sitechanges-type-file-deleted]
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="file_renamed">
                                [module-sitechanges-type-file-renamed]
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="votes_deleted">
                                [module-sitechanges-type-votes-deleted]
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="authorship">
                                [module-sitechanges-type-authorship]
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="wikidot">
                                [module-sitechanges-type-wikidot]
                            </label>
                            <br>
                        
                    </td>
                </tr>
                <tr>
                    <td>[module-sitechanges-category]</td>
                    <td>
                        <select id="rev-category">
                            <option value="*" selected>[module-sitechanges-category-all]</option>
                            
                                <option value="_default">
                                    _default
                                </option>
                            
                                <option value="component">
                                    component
                                </option>
                            
                                <option value="forum">
                                    forum
                                </option>
                            
                                <option value="nav">
                                    nav
                                </option>
                            
                                <option value="probe">
                                    probe
                                </option>
                            
                                <option value="probecss">
                                    probecss
                                </option>
                            
                                <option value="probeoff">
                                    probeoff
                                </option>
                            
                                <option value="probestars">
                                    probestars
                                </option>
                            
                                <option value="search">
                                    search
                                </option>
                            
                        </select>
                    </td>
                </tr>
                <tr>
                    <td>[module-sitechanges-username]<br><span style="font-size: 75%">[module-sitechanges-username-hint]</span></td>
                    <td>
                        <input value="" id="rev-username"> 
