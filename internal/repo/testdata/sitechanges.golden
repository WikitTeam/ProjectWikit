title: Probe Changes
status: 200
<div class="site-changes-box w-site-changes" data-site-changes-path-params="{&quot;perpage&quot;: &quot;5&quot;, &quot;username&quot;: &quot;~%&quot;}" data-site-changes-params="{}">
            <style>
                .changes-list{}
                
                .changes-list .pager{
                    margin: 1em 0;
                    text-align: center;
                }
                
                .changes-list-item{
                    /* overflow: hidden; */
                    padding: 2px;
                }
                
                .changes-list-item:hover{
                    background-color: #F2F2F2;
                }
                
                .changes-list-item table{
                    width: 98%;
                    
                }
                
                .changes-list-item .title{
                
                }
                
                .changes-list-item .mod-date{
                    text-align: right;
                    width: 13em;
                
                }
                .changes-list-item .revision-no{
                    text-align: center;
                    width: 7em;
                }
                .changes-list-item .flags{
                    text-align: left;
                    width: 3em;
                }
                .changes-list-item .mod-by{
                    width: 15em;
                    text-align: left;
                }
                
                .changes-list-item .comments{
                    font-size: 95%;
                    color: #666;
                    margin: 2px 0;
                }
            </style>
            <form onsubmit="return false;" action="" method="get">
                <table class="form">
                <tbody>
                <tr>
                    <td>编辑类型：</td>
                    <td class="w-type-filter">
                        <label>
                            <input type="checkbox" class="checkbox" checked name="*">
                            全部
                        </label>
                        <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="source">
                                文章内容已更改
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="title">
                                标题已更改
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="name">
                                页面已重命名/删除
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="tags">
                                标签已更改
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="new">
                                新页面已创建
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="parent">
                                父页面已更改
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="file_added">
                                文件已添加
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="file_deleted">
                                文件已删除
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="file_renamed">
                                文件已重命名
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="votes_deleted">
                                投票已更改
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="authorship">
                                作者已更改
                            </label>
                            <br>
                        
                            <label>
                                <input type="checkbox" class="checkbox" name="wikidot">
                                从Wikidot移植的编辑
                            </label>
                            <br>
                        
                    </td>
                </tr>
                <tr>
                    <td>选择分类：</td>
                    <td>
                        <select id="rev-category">
                            <option value="*" selected>所有分类</option>
                            
                                <option value="_default">
                                    _default
                                </option>
                            
                                <option value="component">
                                    component
                                </option>
                            
                                <option value="forum">
                                    forum
                                </option>
                            
                                <option value="nav">
                                    nav
                                </option>
                            
                                <option value="probe">
                                    probe
                                </option>
                            
                                <option value="probecss">
                                    probecss
                                </option>
                            
                                <option value="probeoff">
                                    probeoff
                                </option>
                            
                                <option value="probestars">
                                    probestars
                                </option>
                            
                                <option value="search">
                                    search
                                </option>
                            
                        </select>
                    </td>
                </tr>
                <tr>
                    <td>按用户名筛选：<br><span style="font-size: 75%">使用前缀"~"进行部分<br>用户名匹配筛选</span></td>
                    <td>
                        <input value="~%" id="rev-username"> 
                    </td>
                </tr>
                <tr>
                    <td>每页条目数：</td>
                    <td>
                        <select id="rev-perpage">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                            <option value="200">200</option>
                        </select>
                    </td>
                </tr>
                </tbody>
                </table>
                <div class="buttons">
                    <input class="btn btn-default btn-sm" type="button" value="刷新列表">
                </div>
            </form>
            <div id="site-changes-list" class="changes-list">
                
                
                
            </div>
        </div>
